{
  "name": "envryn",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @envryn/ui",
    "build": "npm run build --workspace @envryn/ui",
    "tauri": "cargo tauri",
    "tauri:dev": "cargo tauri dev",
    "tauri:build": "cargo tauri build",
    "build:native-ui": "npm run sync:android-icons && npm run patch:android-mdns && npm run build --workspace @envryn/ui && npm run prepare:sidecar",
    "prepare:sidecar": "node .dev-tools/prepare-sidecar.mjs",
    "sync:android-icons": "node .dev-tools/sync-android-icons.mjs",
    "patch:android-mdns": "node .dev-tools/patch-android-mdns.mjs",
    "test:e2e": "playwright test",
    "test:bundle-budget": "node .dev-tools/check-bundle-budget.mjs",
    "test:security-invariants": "node .dev-tools/verify-security-invariants.mjs",
    "security:scan": "powershell -NoProfile -ExecutionPolicy Bypass -File .dev-tools/security-gate.ps1",
    "security:scan-apk": "powershell -NoProfile -ExecutionPolicy Bypass -File .dev-tools/mobsf-apk-scan.ps1",
    "sign:apk": "node .dev-tools/sign-apk.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspace @envryn/ui"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  }
}
