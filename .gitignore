# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# JS
node_modules
dist
*.local

# Rust
target/
**/target/

# Tauri
src-tauri/gen/
src-tauri/binaries/
apps/ui/src/routeTree.gen.ts

# Local AI models -- never committed (large, and not ours to redistribute)
models/
*.gguf

# Vault data must never enter the repository
*.envryn
*.envrynbk
vault-data/

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Dev-only model files for manual AI testing (see crates/envryn-core/tests/ai_real_model.rs)
/.dev-models/

# Dev-only native-window WebDriver tooling (see .dev-tools/webdriver-smoke.mjs)
# -- the driver binary is machine-specific (must match the installed Edge
# version) and Microsoft's to distribute, not ours; screenshots/page-source
# are throwaway run output. The script itself is tracked.
/.dev-tools/edgedriver*
/.dev-tools/*.png
/.dev-tools/page-source.html

# Local SonarScanner working directory -- throwaway per-run cache, not ours
# to commit (see docs/audits/AUDIT_REPORT.md for the real, committed findings).
.scannerwork/

# Test coverage reports -- generated by `npm run test:coverage` / `cargo
# llvm-cov`, consumed by CI's SonarQube job, never committed.
apps/ui/coverage/
lcov.info
target/llvm-cov/
playwright-report/
test-results/

# Android signing material. The real keystore lives outside this repo
# entirely (~/.envryn/), so these patterns are defence in depth rather than
# the primary control -- a signing key committed once is compromised forever,
# and Android has no key-rotation path: an update signed with a different key
# cannot install over an existing installation.
*.jks
*.keystore
keystore-password.txt
keystore.properties
