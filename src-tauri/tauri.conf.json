{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Envryn",
  "version": "0.1.1",
  "identifier": "dev.envryn.vault",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @envryn/ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace @envryn/ui && npm run prepare:sidecar",
    "frontendDist": "../apps/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Envryn",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico", "icons/128x128.png", "icons/32x32.png"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
